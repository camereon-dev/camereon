import 'dart:convert';
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:path_provider/path_provider.dart';

import 'evaluator.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const EvaluationApp());
}

class EvaluationApp extends StatelessWidget {
  const EvaluationApp({super.key});
  @override
  Widget build(BuildContext context) => MaterialApp(
    title: 'camereon VLM evaluation',
    theme: ThemeData(colorSchemeSeed: const Color(0xFF235C43)),
    home: const EvaluationScreen(),
  );
}

class EvaluationScreen extends StatefulWidget {
  const EvaluationScreen({super.key});
  @override
  State<EvaluationScreen> createState() => _EvaluationScreenState();
}

class _EvaluationScreenState extends State<EvaluationScreen> {
  Map<String, dynamic> report = {'status': 'waiting', 'phase': 'preflight'};
  bool running = false;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _run());
  }

  Future<void> _run() async {
    if (running) return;
    setState(() => running = true);
    try {
      final directory = await getApplicationSupportDirectory();
      final configFile = File('${directory.path}/eval-config.json');
      if (!await configFile.exists()) {
        throw StateError('実行設定がありません。Mac 側で run.py を実行してください。');
      }
      final config =
          jsonDecode(await configFile.readAsString()) as Map<String, dynamic>;
      final manifest = jsonDecode(
        await rootBundle.loadString('assets/eval/manifest.json'),
      ) as List;
      final images = <EvaluationImage>[];
      for (final item in manifest) {
        final bytes = await rootBundle.load('assets/eval/${item['file']}');
        images.add(
          EvaluationImage(
            item['id'] as String,
            bytes.buffer.asUint8List(bytes.offsetInBytes, bytes.lengthInBytes),
            ocrBlocks: (item['ocr_blocks'] as List? ?? const [])
                .cast<Map<String, dynamic>>(),
          ),
        );
      }
      for (final item in config['images'] as List? ?? const []) {
        final file = File('${directory.path}/eval-images/${item['file']}');
        images.add(
          EvaluationImage(item['id'] as String, await file.readAsBytes()),
        );
      }
      final onlyImages = config['only_images'] as List?;
      if (onlyImages != null && onlyImages.isNotEmpty) {
        images.removeWhere((image) => !onlyImages.contains(image.id));
      }
      if (images.isEmpty) throw StateError('評価する画像がありません。');
      await VisionImageEvaluator().run(
        config: config,
        images: images,
        output: File('${directory.path}/eval-result.json'),
        onProgress: (value) {
          if (mounted) setState(() => report = value);
        },
      );
    } catch (error) {
      final failure = {'status': 'preflight_failed', 'error': error.toString()};
      final directory = await getApplicationSupportDirectory();
      await File('${directory.path}/eval-result.json')
          .writeAsString(jsonEncode(failure));
      if (mounted) {
        setState(() => report = failure);
      }
    } finally {
      if (mounted) setState(() => running = false);
    }
  }

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(title: const Text('VLM 画像入力の検証')),
    body: SafeArea(
      child: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          const Text('画像入力・速度・メモリを確認します。リスク評価は行いません。'),
          const SizedBox(height: 16),
          if (running) const LinearProgressIndicator(),
          const SizedBox(height: 16),
          Text(
            '${report['status']} / ${report['phase'] ?? ''}',
            style: Theme.of(context).textTheme.titleMedium,
          ),
          const SizedBox(height: 12),
          FilledButton(
            onPressed: running ? null : _run,
            child: const Text('検証を実行'),
          ),
          const SizedBox(height: 20),
          SelectableText(const JsonEncoder.withIndent('  ').convert(report)),
        ],
      ),
    ),
  );
}
